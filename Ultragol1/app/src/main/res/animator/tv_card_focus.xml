<?xml version="1.0" encoding="utf-8"?>
<!--
  StateListAnimator for TV card focus.
  Focused: scale up to 108% + raise elevation.
  Normal : scale back to 100%, lower elevation.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="1.08"
                android:valueType="floatType"
                android:duration="150"/>
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="1.08"
                android:valueType="floatType"
                android:duration="150"/>
            <objectAnimator
                android:propertyName="translationZ"
                android:valueTo="8"
                android:valueType="floatType"
                android:duration="150"/>
        </set>
    </item>

    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:duration="150"/>
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:duration="150"/>
            <objectAnimator
                android:propertyName="translationZ"
                android:valueTo="0"
                android:valueType="floatType"
                android:duration="150"/>
        </set>
    </item>

</selector>
