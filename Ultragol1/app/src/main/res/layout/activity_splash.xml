<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Spotlight amplio de fondo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_radial_splash"/>

    <!-- Núcleo del glow: anima con pulso -->
    <View
        android:id="@+id/splashGlowInner"
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_glow_orb"
        android:alpha="0"/>

    <!-- Anillos concéntricos, estilo "Quetzalito" -->
    <View
        android:id="@+id/splashRingOuter"
        android:layout_width="336dp"
        android:layout_height="336dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_ring_outer"
        android:alpha="0"/>

    <View
        android:id="@+id/splashRingMid"
        android:layout_width="292dp"
        android:layout_height="292dp"
        android:layout_gravity="center"
        android:background="@drawable/splash_ring_mid"
        android:alpha="0"/>

    <!-- Contenido dentro del anillo: logo, línea, spinner -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Logo (con marca ya incluida en la imagen) -->
        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_ultragol_splash"
            android:scaleType="fitCenter"
            android:alpha="0"/>

        <!-- Línea divisoria fina, degradado rojo -->
        <View
            android:id="@+id/splashDivider"
            android:layout_width="72dp"
            android:layout_height="2dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/splash_progress_fill"
            android:alpha="0"/>

        <!-- Spinner circular -->
        <ProgressBar
            android:id="@+id/splashSpinner"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="22dp"
            android:indeterminateTint="#D50000"
            android:alpha="0"/>

    </LinearLayout>

</FrameLayout>
