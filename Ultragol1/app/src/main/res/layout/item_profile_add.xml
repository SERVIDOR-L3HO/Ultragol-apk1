<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <!-- Glass card — mismo tamaño que item_profile_card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/profile_card_glass_v2"
        android:gravity="center">

        <!-- Dashed ring con orange tint -->
        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/profile_add_ring_v2"
            android:gravity="center">

            <!-- Plus icon drawn with text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="#99D50000"
                android:textSize="36sp"
                android:fontFamily="sans-serif-light"/>
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:text="Añadir perfil"
        android:textColor="#66FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"/>

    <!-- Spacer para alinear con la fila del PIN badge -->
    <View android:layout_width="1dp" android:layout_height="23dp"/>

</LinearLayout>
