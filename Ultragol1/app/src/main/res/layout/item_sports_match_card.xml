<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sport_match_card"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/smBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● EN VIVO"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/agenda_live_badge"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"/>

        <TextView
            android:id="@+id/smLeague"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textColor="#88FFFFFF"
            android:textSize="9.5sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="end"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/smLogoHome"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/live_logo_circle_bg"
            android:padding="5dp"
            android:scaleType="fitCenter"/>

        <TextView
            android:id="@+id/smScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="VS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-black"/>

        <ImageView
            android:id="@+id/smLogoAway"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/live_logo_circle_bg"
            android:padding="5dp"
            android:scaleType="fitCenter"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/smHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#DDFFFFFF"
            android:textSize="9.5sp"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="start"/>

        <TextView
            android:id="@+id/smAway"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#DDFFFFFF"
            android:textSize="9.5sp"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="end"/>
    </LinearLayout>

    <TextView
        android:id="@+id/smTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#66FFFFFF"
        android:textSize="9.5sp"/>

    <TextView
        android:id="@+id/smWatch"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="10dp"
        android:text="▶  WATCH NOW"
        android:textColor="#FFFFFF"
        android:textSize="10.5sp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.03"
        android:gravity="center"
        android:background="@drawable/sport_stream_btn"/>
</LinearLayout>
