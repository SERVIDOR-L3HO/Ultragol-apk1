<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sport_match_card"
    android:padding="8dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:background="#181818">
        <ImageView
            android:id="@+id/scLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:contentDescription="Logo del canal"/>
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:text="▶"
            android:textColor="#EEFFFFFF"
            android:textSize="19sp"
            android:gravity="center"
            android:background="@drawable/sport_play_pill_bg"/>
    </FrameLayout>

    <TextView
        android:id="@+id/scName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:fontFamily="sans-serif-bold"
        android:maxLines="2"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/scCountry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#B8FFFFFF"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end"/>
    <TextView
        android:id="@+id/scStreams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#FFCC5500"
        android:textSize="8sp"
        android:fontFamily="sans-serif-bold"/>
</LinearLayout>