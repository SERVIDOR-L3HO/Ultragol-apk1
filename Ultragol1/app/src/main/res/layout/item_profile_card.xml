<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="10dp">

    <!-- Glass card -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/profile_card_glass"
        android:gravity="center">

        <!-- Avatar circle -->
        <FrameLayout
            android:id="@+id/avatarCircle"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/profile_avatar_circle">

            <TextView
                android:id="@+id/tvInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:fontFamily="sans-serif-black"/>
        </FrameLayout>

        <!-- Delete × top-right — visible in manage mode -->
        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/back_btn_glass"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Kids badge top-left -->
        <TextView
            android:id="@+id/badgeKids"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:text="KIDS"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:background="@drawable/ep_season_pill_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- Profile name -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Nombre"
        android:textColor="#EEFFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- PIN indicator -->
    <TextView
        android:id="@+id/tvPinBadge"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_gravity="center"
        android:layout_marginTop="3dp"
        android:text="🔒 PIN"
        android:textColor="#FF6B00"
        android:textSize="10sp"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:visibility="invisible"/>

</LinearLayout>
