<?xml version="1.0" encoding="utf-8"?>
<!--
  Individual featured card inside the horizontal carousel.
  Wider, taller card with prominent logo and gradient name overlay.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="185dp"
    android:layout_height="140dp"
    android:layout_marginEnd="10dp"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/tv_card_focus"
    app:cardCornerRadius="22dp"
    app:cardElevation="14dp"
    app:cardBackgroundColor="#20162040">

    <!-- Category colour tint wash -->
    <View
        android:id="@+id/vFeaturedColorWash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#28162040"/>

    <!-- Channel logo — centred -->
    <ImageView
        android:id="@+id/ivFeaturedLogo"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:scaleType="centerInside"
        android:padding="6dp"
        android:contentDescription="Logo canal destacado"/>

    <!-- Bottom gradient scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/tv_card_bottom_gradient"/>

    <!-- Glass border overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tv_featured_card_bg"/>

    <!-- LIVE badge — top right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/tv_glass_live_badge"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_margin="10dp">

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/red_dot"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EN VIVO"
            android:textColor="#FFFFFFFF"
            android:textSize="8sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.06"/>
    </LinearLayout>

    <!-- Bottom info: flag + name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvFeaturedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvFeaturedFlag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:layout_marginEnd="5dp"/>

            <TextView
                android:id="@+id/tvFeaturedCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_cat_badge"
                android:textColor="#BBFFFFFF"
                android:textSize="8sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
