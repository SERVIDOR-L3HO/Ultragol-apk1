<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView raíz: elimina la scrollbar del sistema del AlertDialog -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/profile_dialog_bg">

        <!-- ── HEADER: avatar centrado con glow ──────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/dialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nuevo perfil"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.01"
                android:layout_marginBottom="18dp"/>

            <!-- Avatar con glow ring -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/profile_avatar_glow_ring"
                    android:alpha="0.85"/>

                <FrameLayout
                    android:id="@+id/avatarPreview"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_gravity="center"
                    android:background="@drawable/profile_avatar_circle">

                    <TextView
                        android:id="@+id/avatarInitialPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:fontFamily="sans-serif-black"/>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- ── BODY ──────────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="22dp">

            <!-- Campo de nombre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/profile_name_input_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOMBRE DEL PERFIL"
                    android:textColor="#88FFFFFF"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.10"
                    android:layout_marginBottom="5dp"/>

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej: Juan, Mamá, Niños…"
                    android:textColorHint="#44FFFFFF"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@null"
                    android:padding="0dp"
                    android:maxLength="20"
                    android:singleLine="true"
                    android:inputType="textPersonName|textCapWords"
                    android:imeOptions="actionDone"/>
            </LinearLayout>

            <!-- Label color -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COLOR DEL AVATAR"
                android:textColor="#88FFFFFF"
                android:textSize="9sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.10"
                android:layout_marginBottom="10dp"/>

            <!-- Fila de colores — centrada, sin scroll (el diálogo es ancho) -->
            <LinearLayout
                android:id="@+id/colorPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#12FFFFFF"
                android:layout_marginBottom="12dp"/>

            <!-- Perfil infantil toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/profile_card_glass_v2"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👶"
                    android:textSize="22sp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Perfil infantil"
                        android:textColor="#EEFFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Solo contenido para niños"
                        android:textColor="#66FFFFFF"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchKids"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- PIN protect -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/profile_card_glass_v2"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="20sp"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proteger con PIN"
                        android:textColor="#EEFFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"/>

                    <TextView
                        android:id="@+id/tvPinStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin PIN configurado"
                        android:textColor="#66FFFFFF"
                        android:textSize="11sp"
                        android:maxLines="1"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnSetPin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configurar"
                    android:textColor="#FF6B00"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Botón guardar -->
            <TextView
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="GUARDAR PERFIL"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"
                android:gravity="center"
                android:background="@drawable/profile_save_btn"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
