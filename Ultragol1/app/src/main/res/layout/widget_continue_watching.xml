<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E5000000"
    android:padding="10dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▶"
            android:textColor="#D50000"
            android:textSize="11sp"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Continuar viendo"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.02"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIONPLAY"
            android:textColor="#44FFFFFF"
            android:textSize="8sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08"/>
    </LinearLayout>

    <!-- Carousel (StackView) — swipe horizontally to browse items -->
    <StackView
        android:id="@+id/wStack"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:loopViews="true"/>

    <!-- Empty state — shown by setEmptyView when adapter has 0 items -->
    <TextView
        android:id="@+id/wEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Abre la app y empieza a ver contenido"
        android:textColor="#44FFFFFF"
        android:textSize="11sp"
        android:gravity="center"
        android:visibility="gone"/>

</LinearLayout>
