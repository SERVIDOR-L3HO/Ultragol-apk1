<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">
    <FrameLayout android:id="@+id/webviewContainer"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <WebView android:id="@+id/playerWebView"
            android:layout_width="match_parent" android:layout_height="match_parent"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:background="@drawable/gradient_top_black">
            <ImageView android:id="@+id/btnPlayerBack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="#FFFFFF" android:padding="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/playerTitle"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp"
                android:textColor="#FFFFFF" android:textSize="15sp"
                android:fontFamily="sans-serif-medium" android:maxLines="1"
                android:ellipsize="end"/>
            <!-- Cast button — hidden until a stream URL is captured -->
            <TextView android:id="@+id/btnPlayerCastWaiting"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="Capturando…" android:textColor="#66FFFFFF" android:textSize="10sp"
                android:gravity="center" android:visibility="gone"/>
            <TextView android:id="@+id/btnPlayerCast"
                android:layout_width="44dp" android:layout_height="44dp"
                android:text="📡" android:textSize="20sp" android:gravity="center"
                android:clickable="true" android:focusable="true"
                android:visibility="gone"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/playerProgress"
            android:layout_width="match_parent" android:layout_height="3dp"
            android:layout_gravity="top" android:layout_marginTop="56dp"
            android:progressDrawable="@drawable/progress_orange"
            android:max="100" android:visibility="gone"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
    </FrameLayout>
    <FrameLayout android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" android:background="#000000"/>
</FrameLayout>
