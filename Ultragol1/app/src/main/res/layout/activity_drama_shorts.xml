<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <!-- Top bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:background="#0D0D0D">

        <!-- Back arrow -->
        <TextView
            android:id="@+id/dsBtnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|start"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🎬 Shorts Dramas"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:fontFamily="sans-serif-black"/>
    </FrameLayout>

    <!-- Search bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/nav_card_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <EditText
            android:id="@+id/dsSearchInput"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Buscar dramas cortos..."
            android:hintTextColor="#66FFFFFF"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@null"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"/>
    </FrameLayout>

    <!-- Tabs -->
    <LinearLayout
        android:id="@+id/dsTabs"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tabRecientes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recientes"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/tab_active_bg"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tabPopulares"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Populares"
            android:textColor="#88FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tabTendencias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Tendencias"
            android:textColor="#88FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Loading indicator -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        android:id="@+id/dsLoading">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>
    </FrameLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/dsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Sin resultados"
        android:textColor="#66FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone"/>

    <!-- Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dsGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"/>

</LinearLayout>
