<?xml version="1.0" encoding="utf-8"?>
<!-- Card estilo TV-guide: 165dp × 130dp, nombre dentro con gradiente -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="165dp"
    android:layout_height="130dp"
    android:layout_marginEnd="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:background="@drawable/tv_home_card_gradient">

    <!-- Color de categoría (set en código, capa de tinte) -->
    <View
        android:id="@+id/vChannelColor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Inicial grande como watermark -->
    <TextView
        android:id="@+id/tvChannelInitial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#18FFFFFF"
        android:textSize="72sp"
        android:fontFamily="sans-serif-black"
        android:paddingBottom="24dp"/>

    <!-- Logo real del canal -->
    <ImageView
        android:id="@+id/ivChannelLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:padding="14dp"
        android:paddingBottom="36dp"
        android:contentDescription="Logo"/>

    <!-- Gradiente inferior para legibilidad del nombre -->
    <View
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@drawable/tv_card_bottom_scrim"/>

    <!-- Badge LIVE top-left -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/tv_live_pill"
        android:paddingStart="6dp"
        android:paddingEnd="7dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/red_dot"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EN VIVO"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"/>
    </LinearLayout>

    <!-- Nombre + categoría en la parte inferior de la card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"/>

        <TextView
            android:id="@+id/tvChannelCat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#AAFFFFFF"
            android:textSize="9sp"
            android:fontFamily="sans-serif"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"/>
    </LinearLayout>

</FrameLayout>
