<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1C1C1C"
    android:paddingBottom="28dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="#55FFFFFF"/>

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_cast"
            android:tint="#4FC3F7"
            android:contentDescription="Cast"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Transmitir a..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <ImageButton
            android:id="@+id/castBtnCancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#88FFFFFF"
            android:contentDescription="Cerrar"/>
    </LinearLayout>

    <!-- ══ SECCIÓN RECOMENDADO ══════════════════════════════════════════════ -->

    <!-- Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RECOMENDADO"
        android:textColor="#4FC3F7"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"/>

    <!-- Web Video Caster card -->
    <LinearLayout
        android:id="@+id/cardWebVideoCaster"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_recommended_card"
        android:clickable="true"
        android:focusable="true">

        <!-- App icon (loaded dynamically or fallback) -->
        <ImageView
            android:id="@+id/iconWebVideoCaster"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="fitCenter"
            android:contentDescription="Web Video Caster"/>

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <!-- Name + star badge row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Web Video Caster"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="★ TOP"
                    android:textColor="#FFD700"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_gold"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Transmite cualquier video a tu TV"
                android:textColor="#AAFFFFFF"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- Open/Install button -->
        <TextView
            android:id="@+id/btnWebVideoCaster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABRIR"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_blue"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- ══ TRANSMISIÓN LOCAL ════════════════════════════════════════════════ -->

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="4dp"
        android:background="#22FFFFFF"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TRANSMISIÓN LOCAL"
        android:textColor="#00E5A0"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp"/>

    <!-- Glass card local stream -->
    <LinearLayout
        android:id="@+id/cardLocalStream"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_local_stream_card"
        android:padding="16dp">

        <!-- IP status row + copy button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/localStreamDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="9sp"
                android:textColor="#00E5A0"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/localStreamIpLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Red Wi-Fi detectada"
                android:textColor="#8800E5A0"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/btnCopyLocalUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Copiar"
                android:textColor="#00E5A0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_copy"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <!-- URL display box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_url_box"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/localStreamUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="http://—.—.—.—:4445/v.mkv"
                android:textColor="#00E5A0"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:maxLines="3"
                android:ellipsize="end"/>

        </LinearLayout>

        <!-- Hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresa esta URL en VLC/PC o el navegador de tu TV o reproductor."
            android:textColor="#55FFFFFF"
            android:textSize="10sp"
            android:layout_marginBottom="10dp"/>

        <!-- Toggle: Usar streaming local para apps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Usar streaming local para apps"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <Switch
                android:id="@+id/localStreamToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>

        </LinearLayout>

        <!-- Toggle note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nota: El streaming local limpia y optimiza la URL internamente para mejorar la compatibilidad y fluidez en aplicaciones externas."
            android:textColor="#44FFFFFF"
            android:textSize="9sp"/>

    </LinearLayout>

    <!-- Divider before device list -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#22FFFFFF"/>

    <!-- ══ DISPOSITIVOS DETECTADOS ══════════════════════════════════════════ -->

    <!-- Search status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <ProgressBar
            android:id="@+id/castSearching"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="#4FC3F7"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/castStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscando dispositivos..."
            android:textColor="#99FFFFFF"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- Device list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/castDeviceList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:overScrollMode="never"/>

</LinearLayout>
