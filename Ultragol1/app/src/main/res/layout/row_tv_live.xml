<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="24dp"
    android:layout_marginBottom="4dp">

    <!-- Top shimmer divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/live_card_top_shimmer"/>

    <!-- Section header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp"
        android:gravity="center_vertical">

        <!-- Red accent bar -->
        <View
            android:layout_width="4dp"
            android:layout_height="22dp"
            android:background="@color/red_primary"
            android:layout_marginEnd="10dp"/>

        <!-- Title + subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CANALES EN VIVO"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:textAllCaps="true"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/red_dot"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Noticias · Deportes · Entretenimiento"
                    android:textColor="#99D50000"
                    android:textSize="10sp"
                    android:letterSpacing="0.01"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Ver TV button -->
        <TextView
            android:id="@+id/btnVerTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver TV ›"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:background="@drawable/ver_todos_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- Channels horizontal list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTvLive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"/>

    <!-- Bottom shimmer divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/live_card_top_shimmer"/>

</LinearLayout>
