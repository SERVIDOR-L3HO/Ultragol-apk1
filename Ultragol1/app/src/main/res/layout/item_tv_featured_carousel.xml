<?xml version="1.0" encoding="utf-8"?>
<!--
  Featured carousel row — horizontal RecyclerView with big glass cards.
  Sits between the category chips and the main channel grid.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <!-- Section header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <!-- Red accent bar -->
        <View
            android:layout_width="3dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:background="#FFCC1122"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Destacados"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.04"/>

        <View
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/red_dot"
            android:layout_marginEnd="5dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EN VIVO"
            android:textColor="#BBFFFFFF"
            android:textSize="9sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"/>
    </LinearLayout>

    <!-- Horizontal carousel -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFeatured"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"/>

</LinearLayout>
