<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="#161616">

        <ImageView
            android:id="@+id/wpBtnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="🎬 Ver en grupo"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:fontFamily="sans-serif-bold"/>

        <!-- Room code badge -->
        <TextView
            android:id="@+id/wpRoomCodeBadge"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.1"
            android:background="@drawable/btn_watch_party_bg"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Lobby screen (pre-join) -->
    <ScrollView
        android:id="@+id/wpLobbyView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Movie info card -->
            <LinearLayout
                android:id="@+id/wpMovieCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/action_btn_bg"
                android:padding="14dp"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:id="@+id/wpMoviePoster"
                    android:layout_width="56dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:background="#1A1A1A"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/wpMovieTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="2"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/wpMovieMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#88FFFFFF"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- CREAR SALA section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Crear una sala"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/wpCreatePassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Contraseña (opcional)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/action_btn_bg"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/wpCreateName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Tu nombre en la sala"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/action_btn_bg"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/wpBtnCreate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="🚀 Crear sala"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:background="@drawable/btn_watch_party_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="32dp"/>

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="28dp">
                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="#22FFFFFF"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  o únete con código  "
                    android:textColor="#55FFFFFF" android:textSize="12sp"/>
                <View android:layout_width="0dp" android:layout_height="1dp"
                    android:layout_weight="1" android:background="#22FFFFFF"/>
            </LinearLayout>

            <!-- UNIRSE A SALA section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unirte a una sala"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/wpJoinCode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Código de sala (ej: ABC123)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-bold"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/action_btn_bg"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/wpJoinPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Contraseña (si la sala la tiene)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/action_btn_bg"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/wpJoinName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Tu nombre en la sala"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/action_btn_bg"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:id="@+id/wpBtnJoin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="🔗 Unirme a la sala"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:background="@drawable/action_btn_bg"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="16dp"/>

            <!-- Status message -->
            <TextView
                android:id="@+id/wpStatusMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FF6B6B"
                android:textSize="13sp"
                android:gravity="center"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

    <!-- Room screen (post-join, hidden until in room) -->
    <LinearLayout
        android:id="@+id/wpRoomView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Participants bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#161616">

            <TextView
                android:id="@+id/wpParticipantsLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp"
                android:text="👥 Solo tú"/>

            <!-- Copy code button -->
            <TextView
                android:id="@+id/wpBtnCopyCode"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center"
                android:text="📋 Copiar código"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:background="@drawable/action_btn_bg"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Playback sync controls (host only) -->
        <LinearLayout
            android:id="@+id/wpHostControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="10dp"
            android:background="#0D0D0D"
            android:visibility="gone">

            <TextView
                android:id="@+id/wpBtnSyncPlay"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:text="▶ Reproducir todos"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/btn_watch_party_bg"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/wpBtnSyncPause"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:gravity="center"
                android:text="⏸ Pausar todos"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/action_btn_bg"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Guest sync notification bar -->
        <TextView
            android:id="@+id/wpSyncBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⏳ Esperando al host…"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#7B2FBE"
            android:visibility="gone"/>

        <!-- Chat area -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/wpChatRv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"/>

        <!-- Chat input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:background="#161616">

            <EditText
                android:id="@+id/wpChatInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Escribe un mensaje…"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="text"
                android:background="@drawable/action_btn_bg"
                android:maxLines="1"
                android:imeOptions="actionSend"/>

            <TextView
                android:id="@+id/wpBtnSend"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="➤"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:background="@drawable/btn_watch_party_bg"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
