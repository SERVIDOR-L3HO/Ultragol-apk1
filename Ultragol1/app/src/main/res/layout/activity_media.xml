<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- ── Video Surface ────────────────────────────────────────────────── -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        android:background="#000000"/>

    <!-- ── Buffering Spinner ─────────────────────────────────────────────── -->
    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:indeterminateTint="#E50914"
        android:visibility="visible"/>

    <!-- ── Controls Overlay ──────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Top gradient scrim -->
        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="top"
            android:background="@drawable/gradient_top_black"/>

        <!-- Bottom gradient scrim -->
        <View
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_detail_bottom"/>

        <!-- ── TOP BAR ─────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:tint="#FFFFFF"
                android:contentDescription="Volver"/>

            <TextView
                android:id="@+id/tvMediaTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"/>

            <ImageButton
                android:id="@+id/btnLock"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_media_lock"
                android:tint="#CCFFFFFF"
                android:contentDescription="Bloquear pantalla"
                android:layout_marginEnd="2dp"/>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_media_settings"
                android:tint="#CCFFFFFF"
                android:contentDescription="Configuración"/>

            <ImageButton
                android:id="@+id/btnCast"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cast"
                android:tint="#66FFFFFF"
                android:contentDescription="Transmitir a TV"
                android:layout_marginStart="2dp"/>
        </LinearLayout>

        <!-- ── CENTER CONTROLS ────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/glass_btn_circle"
                android:src="@drawable/ic_media_replay10"
                android:tint="#FFFFFF"
                android:contentDescription="-10 segundos"
                android:scaleType="centerInside"
                android:padding="14dp"/>

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/glass_btn_circle_accent"
                android:src="@drawable/ic_media_play"
                android:tint="#FFFFFF"
                android:contentDescription="Reproducir/Pausar"
                android:scaleType="centerInside"
                android:padding="18dp"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                android:elevation="4dp"/>

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/glass_btn_circle"
                android:src="@drawable/ic_media_forward10"
                android:tint="#FFFFFF"
                android:contentDescription="+10 segundos"
                android:scaleType="centerInside"
                android:padding="14dp"/>
        </LinearLayout>

        <!-- ── NETFLIX-STYLE NEXT EPISODE ─────────────────────────────── -->
        <LinearLayout
            android:id="@+id/nextEpisodeCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="92dp"
            android:orientation="vertical"
            android:gravity="end"
            android:padding="12dp"
            android:background="@drawable/next_episode_card_bg"
            android:elevation="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvNextEpisodeCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Siguiente episodio en 5"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp"
                android:layout_marginBottom="6dp"/>

            <Button
                android:id="@+id/btnNextEpisode"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="0dp"
                android:text="▶  Próximo episodio"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/next_episode_button_bg"/>
        </LinearLayout>

        <!-- ── BOTTOM BAR ─────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Seekbar row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00 / 0:00"
                    android:textColor="#DDFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="10dp"
                    android:shadowColor="#AA000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"/>

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="#E50914"
                    android:thumbTint="#FFFFFF"
                    android:secondaryProgressTint="#40FFFFFF"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"/>
            </LinearLayout>

            <!-- Action buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <!-- Fit/Zoom -->
                <ImageButton
                    android:id="@+id/btnFitCrop"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_media_fit"
                    android:tint="#AAFFFFFF"
                    android:contentDescription="Ajuste de pantalla"
                    android:scaleType="centerInside"
                    android:padding="8dp"/>

                <!-- Speed chip -->
                <TextView
                    android:id="@+id/btnSpeedChip"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="1×"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/glass_chip"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- Spacer -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <!-- Change server -->
                <ImageButton
                    android:id="@+id/btnServer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_media_server"
                    android:tint="#AAFFFFFF"
                    android:contentDescription="Cambiar servidor"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:layout_marginEnd="2dp"/>

                <!-- PiP -->
                <ImageButton
                    android:id="@+id/btnPip"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_media_pip"
                    android:tint="#AAFFFFFF"
                    android:contentDescription="Imagen en imagen"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:layout_marginEnd="2dp"/>

                <!-- Sleep timer icon -->
                <TextView
                    android:id="@+id/btnSleepTimer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="⏱"
                    android:textSize="19sp"
                    android:gravity="center"
                    android:textColor="#AAFFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ── LOCK OVERLAY ───────────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/lockOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/unlockHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="20dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/glass_chip"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnUnlock"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_media_unlock"
                android:tint="#FFFFFF"
                android:contentDescription="Desbloquear"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desbloquear"
                android:textColor="#BBFFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="5dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- ── Double-tap left ───────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvTapLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="36dp"
        android:text="« 10s"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:background="@drawable/glass_chip"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"/>

    <!-- ── Double-tap right ──────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvTapRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="36dp"
        android:text="10s »"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:background="@drawable/glass_chip"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"/>

    <!-- ── Gesture Indicator ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/gestureIndicator"
        android:layout_width="116dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_chip"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGestureIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:text="🔊"/>

        <TextView
            android:id="@+id/tvGesturePercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- ── Sleep Timer Countdown ─────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvSleepTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/glass_chip"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:visibility="gone"/>

    <!-- ── Resume Card ───────────────────────────────────────────────────── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/resumeCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="130dp"
        app:cardBackgroundColor="#CC0A0A0A"
        app:cardCornerRadius="14dp"
        app:cardElevation="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvResumeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#DDFFFFFF"
                android:textSize="13sp"
                android:layout_marginEnd="12dp"/>

            <Button
                android:id="@+id/btnResume"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Continuar"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E50914"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFromStart"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Inicio"
                android:textColor="#CCFFFFFF"
                android:textAllCaps="false"
                android:textSize="13sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ── Settings Panel (glass, slides from right) ─────────────────────── -->
    <ScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="288dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F0060606"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="44dp"
            android:paddingBottom="40dp">

            <!-- Header row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Opciones"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <ImageButton
                    android:id="@+id/btnSettingsClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    android:tint="#AAFFFFFF"
                    android:contentDescription="Cerrar"
                    android:rotation="180"/>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="#22FFFFFF" android:layout_marginBottom="16dp"/>

            <!-- SPEED -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VELOCIDAD"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp"/>

            <RadioGroup
                android:id="@+id/rgSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton android:id="@+id/rbSpeed050"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="0.5×   Lento"
                    android:textColor="#DDFFFFFF" android:textSize="14sp"
                    android:buttonTint="#E50914" android:paddingStart="8dp"/>

                <RadioButton android:id="@+id/rbSpeed075"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="0.75×  Moderado"
                    android:textColor="#DDFFFFFF" android:textSize="14sp"
                    android:buttonTint="#E50914" android:paddingStart="8dp"/>

                <RadioButton android:id="@+id/rbSpeed100"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="1×   Normal"
                    android:textColor="#DDFFFFFF" android:textSize="14sp"
                    android:buttonTint="#E50914" android:paddingStart="8dp"
                    android:checked="true"/>

                <RadioButton android:id="@+id/rbSpeed125"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="1.25×  Rápido"
                    android:textColor="#DDFFFFFF" android:textSize="14sp"
                    android:buttonTint="#E50914" android:paddingStart="8dp"/>

                <RadioButton android:id="@+id/rbSpeed150"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="1.5×  Muy rápido"
                    android:textColor="#DDFFFFFF" android:textSize="14sp"
                    android:buttonTint="#E50914" android:paddingStart="8dp"/>

                <RadioButton android:id="@+id/rbSpeed200"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="2×   Turbo"
                    android:textColor="#DDFFFFFF" android:textSize="14sp"
                    android:buttonTint="#E50914" android:paddingStart="8dp"/>
            </RadioGroup>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="#22FFFFFF" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>

            <!-- QUALITY -->
            <TextView
                android:id="@+id/tvQualityHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CALIDAD"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp"
                android:visibility="gone"/>

            <RadioGroup
                android:id="@+id/rgQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"/>

            <!-- Divider (quality) -->
            <View android:id="@+id/dividerQuality"
                android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="#22FFFFFF" android:layout_marginBottom="16dp"
                android:visibility="gone"/>

            <!-- SUBTITLES -->
            <TextView
                android:id="@+id/tvSubsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUBTÍTULOS"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp"
                android:visibility="gone"/>

            <RadioGroup
                android:id="@+id/rgSubtitles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"/>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="#22FFFFFF" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>

            <!-- SLEEP TIMER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEMPORIZADOR DE SUEÑO"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp"/>

            <RadioGroup
                android:id="@+id/rgSleepTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton android:id="@+id/rbTimerOff"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="Desactivado"
                    android:textColor="#DDFFFFFF" android:textSize="14sp"
                    android:buttonTint="#E50914" android:paddingStart="8dp"
                    android:checked="true"/>

                <RadioButton android:id="@+id/rbTimer15"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="15 minutos"
                    android:textColor="#DDFFFFFF" android:textSize="14sp"
                    android:buttonTint="#E50914" android:paddingStart="8dp"/>

                <RadioButton android:id="@+id/rbTimer30"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="30 minutos"
                    android:textColor="#DDFFFFFF" android:textSize="14sp"
                    android:buttonTint="#E50914" android:paddingStart="8dp"/>

                <RadioButton android:id="@+id/rbTimer60"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="60 minutos"
                    android:textColor="#DDFFFFFF" android:textSize="14sp"
                    android:buttonTint="#E50914" android:paddingStart="8dp"/>

                <RadioButton android:id="@+id/rbTimerEnd"
                    android:layout_width="match_parent" android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:text="Al terminar episodio"
                    android:textColor="#DDFFFFFF" android:textSize="14sp"
                    android:buttonTint="#E50914" android:paddingStart="8dp"/>
            </RadioGroup>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="0.5dp"
                android:background="#22FFFFFF" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>

            <!-- CHANGE SERVER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVIDOR DE STREAMING"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnServerFromSettings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
