<?xml version="1.0" encoding="utf-8"?>
<!--
  Glass 3D channel card — used in 2-column GridLayoutManager.
  CardView provides the 3D elevation / shadow. The stateListAnimator
  (tv_card_focus.xml) scales it on focus/press for a tactile feel.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/tv_card_focus"
    app:cardCornerRadius="18dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="#1A162040">

    <!-- Category colour wash behind the logo -->
    <View
        android:id="@+id/vCardColorWash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22162040"/>

    <!-- Channel logo — fills card, text overlays on top -->
    <ImageView
        android:id="@+id/ivChannelLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:contentDescription="Logo"/>

    <!-- Bottom gradient scrim for text legibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:background="@drawable/tv_card_bottom_gradient"/>

    <!-- Glass border overlay (drawn on top to crisp the corners) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tv_glass_card_bg"/>

    <!-- TOP ROW: channel number (left) + LIVE badge (right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp">

        <!-- Channel number -->
        <TextView
            android:id="@+id/tvChannelNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#55FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:text="1"/>

        <!-- ● EN VIVO badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/tv_glass_live_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/red_dot"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN VIVO"
                android:textColor="#FFFFFFFF"
                android:textSize="8sp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.06"/>
        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM ROW: flag + name + category badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <!-- Channel name -->
        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- Flag + category in one row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/tvChannelFlag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_marginEnd="5dp"/>

            <TextView
                android:id="@+id/tvChannelCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_cat_badge"
                android:textColor="#BBFFFFFF"
                android:textSize="8sp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
