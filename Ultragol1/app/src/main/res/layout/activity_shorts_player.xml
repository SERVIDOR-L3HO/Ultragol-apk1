<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-screen WebView for Dailymotion embed -->
    <WebView
        android:id="@+id/shortsWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Top overlay: back button + title -->
    <LinearLayout
        android:id="@+id/shortsTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        android:background="#88000000">

        <TextView
            android:id="@+id/shortsBtnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/shortsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingEnd="8dp"/>
    </LinearLayout>

    <!-- Loading indicator while WebView loads -->
    <ProgressBar
        android:id="@+id/shortsLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

</FrameLayout>
