<?xml version="1.0" encoding="utf-8"?>
<!-- CTA button: gradiente naranja sólido premium -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#FF6B00"
                android:endColor="#FFB347"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#CC5500"
                android:centerColor="#FF6B00"
                android:endColor="#FF9040"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>
