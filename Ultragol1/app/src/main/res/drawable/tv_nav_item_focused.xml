<?xml version="1.0" encoding="utf-8"?>
<!--
  Background selector for TV/keyboard-focused navigation items.
  Focused state: bright accent bar on left + subtle highlight fill.
  Normal state: fully transparent.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused (D-pad / keyboard) -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#22D50000"/>
                    <corners android:radius="10dp"/>
                </shape>
            </item>
            <!-- Left accent bar -->
            <item android:width="4dp" android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="#D50000"/>
                    <corners android:topRightRadius="2dp" android:bottomRightRadius="2dp"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33D50000"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>

    <!-- Default / normal (transparent — existing glass panel bg shows through) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>

</selector>
