<?xml version="1.0" encoding="utf-8"?>
<!-- Card glass: fondo dark blue-black con borde naranja premium -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2C1400"
                android:centerColor="#121228"
                android:endColor="#090920"
                android:angle="135"/>
            <stroke android:width="1.5dp" android:color="#DDFF6B00"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1C0A00"
                android:centerColor="#0D0D22"
                android:endColor="#07071A"
                android:angle="135"/>
            <stroke android:width="1dp" android:color="#77FF6B00"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</selector>
