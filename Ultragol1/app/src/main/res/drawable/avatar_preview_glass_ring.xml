<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral glass halo behind the avatar preview — no accent color dependency. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF"/>
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="1.5dp" android:color="#33FFFFFF"/>
        </shape>
    </item>
</layer-list>
