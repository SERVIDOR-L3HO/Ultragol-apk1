<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Orange tinted glass fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#22FF6B00"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <!-- Glass gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30FF8C00"
                android:endColor="#08FF6B00"
                android:angle="270"
                android:type="linear"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <!-- Orange border glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="2dp" android:color="#CCFF6B00"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
</layer-list>
