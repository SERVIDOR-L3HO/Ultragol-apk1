<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#42FF6B35"
                android:endColor="#1A9E2817"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#A0FF8A5E"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF"/>
            <corners android:radius="14dp"/>
            <stroke android:width="2dp" android:color="#FFFF6B35"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#20FFFFFF"
                android:endColor="#0BFFFFFF"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#3DFFFFFF"/>
        </shape>
    </item>
</selector>