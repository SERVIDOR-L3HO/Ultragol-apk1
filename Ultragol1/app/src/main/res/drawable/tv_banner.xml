<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (320x180dp). Solid brand background with the
     app icon centered, so the app has a proper TV-listing image instead of
     falling back to a stretched phone icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/bg_primary" />
    <item android:gravity="center" android:width="96dp" android:height="96dp">
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="center" />
    </item>
</layer-list>
