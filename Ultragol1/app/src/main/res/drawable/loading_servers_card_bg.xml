<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card: fondo dark navy + borde blanco sutil -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark glass -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E0040C18"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <!-- White glass border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#22FFFFFF"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
    <!-- Top highlight: simula reflexión de luz en el vidrio -->
    <item android:top="0dp" android:bottom="120dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#12FFFFFF"
                android:endColor="#00FFFFFF"/>
            <corners android:topLeftRadius="26dp" android:topRightRadius="26dp"
                     android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/>
        </shape>
    </item>
</layer-list>
