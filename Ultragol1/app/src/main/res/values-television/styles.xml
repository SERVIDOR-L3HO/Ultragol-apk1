<?xml version="1.0" encoding="utf-8"?>
<!--
  On Android TV, apply the TV-specific theme so the app is identified as
  a leanback app and gets the correct focus highlight behaviour.
-->
<resources>
    <!-- Override the application theme for TV to include focus styling -->
    <style name="Theme.Ultragol" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryVariant">@color/orange_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- TV: hide status/nav bars by default -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
