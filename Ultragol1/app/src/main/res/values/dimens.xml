<?xml version="1.0" encoding="utf-8"?>
<!--
  Base dimensions (phone, ~360dp wide).
  Override in values-large/ (tablets) and values-television/ (TV).
-->
<resources>
    <!-- Navigation -->
    <dimen name="nav_panel_width">295dp</dimen>
    <dimen name="nav_item_height">54dp</dimen>
    <dimen name="nav_icon_size">22dp</dimen>
    <dimen name="nav_text_size">13sp</dimen>

    <!-- Cards -->
    <dimen name="card_corner_radius">10dp</dimen>
    <dimen name="content_card_width">130dp</dimen>
    <dimen name="content_card_height">190dp</dimen>
    <dimen name="trending_card_height">200dp</dimen>

    <!-- Hero banner -->
    <dimen name="hero_height">220dp</dimen>

    <!-- Text sizes -->
    <dimen name="text_title_large">20sp</dimen>
    <dimen name="text_title_medium">16sp</dimen>
    <dimen name="text_body">13sp</dimen>
    <dimen name="text_caption">11sp</dimen>

    <!-- Spacing -->
    <dimen name="section_padding_horizontal">12dp</dimen>
    <dimen name="section_padding_vertical">8dp</dimen>

    <!-- Player controls -->
    <dimen name="player_btn_size">62dp</dimen>
    <dimen name="player_btn_play_size">80dp</dimen>
    <dimen name="player_btn_padding">14dp</dimen>

    <!-- Home grid columns — used in code via R.integer.home_grid_columns -->
</resources>
