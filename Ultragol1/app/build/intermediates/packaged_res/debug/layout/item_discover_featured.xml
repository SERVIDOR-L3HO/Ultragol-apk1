<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="175dp"
    android:layout_margin="4dp"
    android:background="@drawable/glass_card_bg"
    android:clipChildren="true"
    android:elevation="4dp">

    <ImageView
        android:id="@+id/featuredBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/glass_card_bg"/>

    <!-- Cinematic gradient overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_detail_bottom"/>

    <!-- Left accent stripe -->
    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/red_primary"/>

    <!-- DESTACADO pill top-right -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:text="⭐ DESTACADO"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.04"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/ep_season_pill_bg"/>

    <!-- Bottom info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/featuredTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#AA000000"
            android:shadowRadius="4"/>

        <TextView
            android:id="@+id/featuredMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</FrameLayout>
