<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Fondo: calor naranja muy sutil (spotlight detrás del logo) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_radial_splash"/>

    <!-- Halo naranja centrado detrás del logo -->
    <View
        android:id="@+id/splashGlowOrb"
        android:layout_width="300dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:layout_marginBottom="60dp"
        android:background="@drawable/splash_glow_orb"
        android:alpha="0"/>

    <!-- Contenido central -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Logo Ultragol -->
        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="260dp"
            android:layout_height="84dp"
            android:src="@drawable/logo_ultragol_splash"
            android:scaleType="fitCenter"
            android:alpha="0"/>

        <!-- Línea divisoria: naranja, se expande desde el centro -->
        <View
            android:id="@+id/splashDivider"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="22dp"
            android:layout_gravity="center"
            android:background="#FF6B00"
            android:alpha="0"/>

        <!-- Tagline -->
        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Streaming sin límites"
            android:textColor="#66FFFFFF"
            android:textSize="12sp"
            android:letterSpacing="0.22"
            android:fontFamily="sans-serif-light"
            android:alpha="0"/>

        <!-- Barra de progreso fina (estilo Disney+/HBO Max) -->
        <FrameLayout
            android:id="@+id/splashProgressContainer"
            android:layout_width="180dp"
            android:layout_height="2dp"
            android:layout_marginTop="52dp"
            android:alpha="0">

            <!-- Pista -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@drawable/splash_progress_track"/>

            <!-- Relleno animado -->
            <View
                android:id="@+id/splashProgressFill"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:background="@drawable/splash_progress_fill"/>

        </FrameLayout>

    </LinearLayout>

    <!-- Watermark inferior -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:text="ULTRAGOL1"
        android:textColor="#1AFFFFFF"
        android:textSize="9sp"
        android:letterSpacing="0.30"
        android:fontFamily="sans-serif-medium"/>

</FrameLayout>
