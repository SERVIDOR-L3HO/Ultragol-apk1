<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <!-- Spotlight amplio de fondo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_radial_splash"/>

    <!-- Núcleo del glow: anima con pulso -->
    <View
        android:id="@+id/splashGlowInner"
        android:layout_width="480dp"
        android:layout_height="340dp"
        android:layout_gravity="center"
        android:layout_marginBottom="100dp"
        android:background="@drawable/splash_glow_inner"
        android:alpha="0"/>

    <!-- Logo + Tagline: ligeramente por encima del centro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="100dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Logo: grande y dominante -->
        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="360dp"
            android:layout_height="116dp"
            android:src="@drawable/logo_ultragol_splash"
            android:scaleType="fitCenter"
            android:alpha="0"/>

        <!-- Tagline: aparece deslizándose desde abajo -->
        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Streaming sin límites"
            android:textColor="#90FFFFFF"
            android:textSize="15sp"
            android:letterSpacing="0.18"
            android:fontFamily="sans-serif-light"
            android:alpha="0"/>

    </LinearLayout>

    <!-- Barra de progreso full-width pegada al fondo -->
    <FrameLayout
        android:id="@+id/splashProgressBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:alpha="0">

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#10FFFFFF"/>

        <View
            android:id="@+id/splashProgressFill"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:background="@drawable/splash_progress_fill"/>

    </FrameLayout>

    <!-- Watermark mínima -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="ULTRAGOL1"
        android:textColor="#15FFFFFF"
        android:textSize="9sp"
        android:letterSpacing="0.35"
        android:fontFamily="sans-serif-medium"/>

</FrameLayout>
