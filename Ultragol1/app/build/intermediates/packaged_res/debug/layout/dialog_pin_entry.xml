<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bottom_sheet_bg"
    android:padding="28dp">

    <!-- Lock icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="36sp"
        android:layout_marginBottom="12dp"/>

    <!-- Title -->
    <TextView
        android:id="@+id/pinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Introduce tu PIN"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="6dp"/>

    <!-- Profile name -->
    <TextView
        android:id="@+id/pinProfileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#88FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="28dp"/>

    <!-- 4 dots -->
    <LinearLayout
        android:id="@+id/pinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <View android:id="@+id/dot1"
            android:layout_width="16dp" android:layout_height="16dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
        <View android:id="@+id/dot2"
            android:layout_width="16dp" android:layout_height="16dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
        <View android:id="@+id/dot3"
            android:layout_width="16dp" android:layout_height="16dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
        <View android:id="@+id/dot4"
            android:layout_width="16dp" android:layout_height="16dp"
            android:background="@drawable/pin_dot_empty"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
    </LinearLayout>

    <!-- Error message -->
    <TextView
        android:id="@+id/tvPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PIN incorrecto"
        android:textColor="#E74C3C"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="20dp"
        android:visibility="invisible"/>

    <!-- Numeric keypad -->
    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1: 1 2 3 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:layout_marginBottom="12dp">
            <TextView android:id="@+id/key1" android:layout_width="64dp" android:layout_height="64dp" android:text="1" android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:background="@drawable/pin_key_bg" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/key2" android:layout_width="64dp" android:layout_height="64dp" android:text="2" android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:background="@drawable/pin_key_bg" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/key3" android:layout_width="64dp" android:layout_height="64dp" android:text="3" android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:background="@drawable/pin_key_bg" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Row 2: 4 5 6 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:layout_marginBottom="12dp">
            <TextView android:id="@+id/key4" android:layout_width="64dp" android:layout_height="64dp" android:text="4" android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:background="@drawable/pin_key_bg" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/key5" android:layout_width="64dp" android:layout_height="64dp" android:text="5" android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:background="@drawable/pin_key_bg" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/key6" android:layout_width="64dp" android:layout_height="64dp" android:text="6" android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:background="@drawable/pin_key_bg" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Row 3: 7 8 9 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:layout_marginBottom="12dp">
            <TextView android:id="@+id/key7" android:layout_width="64dp" android:layout_height="64dp" android:text="7" android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:background="@drawable/pin_key_bg" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/key8" android:layout_width="64dp" android:layout_height="64dp" android:text="8" android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:background="@drawable/pin_key_bg" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/key9" android:layout_width="64dp" android:layout_height="64dp" android:text="9" android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:background="@drawable/pin_key_bg" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Row 4: empty / 0 / backspace -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center">
            <View android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/key0" android:layout_width="64dp" android:layout_height="64dp" android:text="0" android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:background="@drawable/pin_key_bg" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/keyDel" android:layout_width="64dp" android:layout_height="64dp" android:text="⌫" android:gravity="center" android:textColor="#AAFFFFFF" android:textSize="20sp" android:background="@drawable/pin_key_bg" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Cancel -->
    <TextView
        android:id="@+id/btnPinCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Cancelar"
        android:textColor="#66FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>
