<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- ExoPlayer surface -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        android:background="#000000" />

    <!-- Loading spinner (center) -->
    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="#E50914"
        android:visibility="visible" />

    <!-- Full-screen controls overlay -->
    <FrameLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Top gradient -->
        <View
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="top"
            android:background="@drawable/gradient_top_black" />

        <!-- Bottom gradient -->
        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_detail_bottom" />

        <!-- ── TOP BAR ─────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:src="@drawable/ic_back"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvMediaTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Configuración"
                android:src="@drawable/ic_media_settings"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- ── BOTTOM BAR ──────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <!-- Seekbar row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnFitCrop"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Ajuste"
                    android:src="@drawable/ic_media_fit"
                    android:tint="#FFFFFF"
                    android:layout_marginEnd="6dp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="#E50914"
                    android:thumbTint="#E50914"
                    android:secondaryProgressTint="#55FFFFFF"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00 / 0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Playback buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="2dp">

                <ImageButton
                    android:id="@+id/btnRewind"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="-10 segundos"
                    android:src="@drawable/ic_media_replay10"
                    android:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Reproducir/Pausar"
                    android:src="@drawable/ic_media_play"
                    android:tint="#FFFFFF"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp" />

                <ImageButton
                    android:id="@+id/btnForward"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="+10 segundos"
                    android:src="@drawable/ic_media_forward10"
                    android:tint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Double-tap left feedback -->
    <TextView
        android:id="@+id/tvTapLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="60dp"
        android:text="« 10s"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="#44FFFFFF"
        android:padding="12dp"
        android:visibility="gone" />

    <!-- Double-tap right feedback -->
    <TextView
        android:id="@+id/tvTapRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="60dp"
        android:text="10s »"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="#44FFFFFF"
        android:padding="12dp"
        android:visibility="gone" />

    <!-- Gesture indicator (brightness / volume / seek) -->
    <LinearLayout
        android:id="@+id/gestureIndicator"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#BB000000"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGestureIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:text="🔊" />

        <TextView
            android:id="@+id/tvGesturePercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Resume card (bottom center) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/resumeCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="130dp"
        app:cardBackgroundColor="#CC1C1C1E"
        app:cardCornerRadius="10dp"
        app:cardElevation="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvResumeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginEnd="14dp" />

            <Button
                android:id="@+id/btnResume"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Sí"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E50914"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnFromStart"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Desde el inicio"
                android:textColor="#CCFFFFFF"
                android:textAllCaps="false" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Settings panel (slides in from right) -->
    <ScrollView
        android:id="@+id/settingsPanel"
        android:layout_width="270dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#EE111111"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingTop="40dp">

            <!-- Speed section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Velocidad"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:alpha="0.6"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton android:id="@+id/rbSpeed050"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0.5×" android:textColor="#FFFFFF"
                    android:buttonTint="#E50914" android:paddingStart="8dp" />

                <RadioButton android:id="@+id/rbSpeed075"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0.75×" android:textColor="#FFFFFF"
                    android:buttonTint="#E50914" android:paddingStart="8dp" />

                <RadioButton android:id="@+id/rbSpeed100"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="1× (Normal)" android:textColor="#FFFFFF"
                    android:buttonTint="#E50914" android:paddingStart="8dp"
                    android:checked="true" />

                <RadioButton android:id="@+id/rbSpeed125"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="1.25×" android:textColor="#FFFFFF"
                    android:buttonTint="#E50914" android:paddingStart="8dp" />

                <RadioButton android:id="@+id/rbSpeed150"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="1.5×" android:textColor="#FFFFFF"
                    android:buttonTint="#E50914" android:paddingStart="8dp" />

                <RadioButton android:id="@+id/rbSpeed200"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="2×" android:textColor="#FFFFFF"
                    android:buttonTint="#E50914" android:paddingStart="8dp" />
            </RadioGroup>

            <!-- Quality section (populated in code when tracks are available) -->
            <TextView
                android:id="@+id/tvQualityHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calidad"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:alpha="0.6"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <RadioGroup
                android:id="@+id/rgQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Subtitles section (populated in code) -->
            <TextView
                android:id="@+id/tvSubsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subtítulos"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:alpha="0.6"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <RadioGroup
                android:id="@+id/rgSubtitles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
