<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <!-- Glass card — mismo tamaño que item_profile_card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:background="@drawable/profile_card_glass_v2"
        android:gravity="center">

        <!-- Dashed ring con orange tint -->
        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/profile_add_ring_v2">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="#88FF6B00"
                android:textSize="38sp"
                android:fontFamily="sans-serif-light"/>
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:text="Añadir perfil"
        android:textColor="#55FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif"/>

    <!-- Spacer para alinear con la fila del PIN badge -->
    <View android:layout_width="1dp" android:layout_height="21dp"/>

</LinearLayout>
