<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="10dp">

    <!-- Glass card same size -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/profile_card_glass"
        android:gravity="center">

        <!-- Dashed ring with + -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/profile_add_ring">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="#66FFFFFF"
                android:textSize="36sp"
                android:fontFamily="sans-serif-light"/>
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Añadir perfil"
        android:textColor="#66FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif"/>

    <!-- Spacer to align with PIN badge row -->
    <View android:layout_width="1dp" android:layout_height="19dp"/>

</LinearLayout>
