<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/miniCastBar"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#EE141414"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:visibility="gone">

    <!-- Poster thumbnail -->
    <ImageView
        android:id="@+id/miniCastPoster"
        android:layout_width="44dp"
        android:layout_height="60dp"
        android:scaleType="centerCrop"
        android:background="#33FFFFFF"
        android:contentDescription="Miniatura"/>

    <!-- Title + device info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp">

        <TextView
            android:id="@+id/miniCastTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/miniCastDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#4FC3F7"
            android:textSize="11sp"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- Play/Pause -->
    <ImageButton
        android:id="@+id/miniCastPlayPause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_media_pause"
        android:tint="#FFFFFF"
        android:contentDescription="Play / Pausa"/>

    <!-- Stop -->
    <ImageButton
        android:id="@+id/miniCastStop"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_cast_stop"
        android:tint="#FF5252"
        android:contentDescription="Detener transmisión"
        android:layout_marginStart="2dp"/>

    <!-- Return to phone -->
    <ImageButton
        android:id="@+id/miniCastLocal"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_cast_phone"
        android:tint="#CCFFFFFF"
        android:contentDescription="Ver en teléfono"
        android:layout_marginStart="2dp"/>

</LinearLayout>
