<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <!-- Glass card -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:background="@drawable/profile_card_glass_v2"
        android:gravity="center">

        <!-- Subtle top-left glare -->
        <View
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="top|start"
            android:background="@drawable/gradient_radial_splash"
            android:alpha="0.06"/>

        <!-- Avatar glow ring (visible on selected via tint/alpha logic in Java) -->
        <View
            android:id="@+id/avatarGlowRing"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:background="@drawable/profile_avatar_glow_ring"
            android:alpha="0"
            android:visibility="visible"/>

        <!-- Avatar circle -->
        <FrameLayout
            android:id="@+id/avatarCircle"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/profile_avatar_circle">

            <TextView
                android:id="@+id/tvInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:fontFamily="sans-serif-black"/>
        </FrameLayout>

        <!-- Delete × top-right — visible en modo gestionar -->
        <FrameLayout
            android:id="@+id/btnDelete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/back_btn_glass"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"/>
        </FrameLayout>

        <!-- Kids badge top-left -->
        <TextView
            android:id="@+id/badgeKids"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:text="KIDS"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:background="@drawable/ep_season_pill_bg"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- Profile name -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:text="Nombre"
        android:textColor="#EEFFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- PIN indicator -->
    <TextView
        android:id="@+id/tvPinBadge"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_gravity="center"
        android:layout_marginTop="3dp"
        android:text="🔒 PIN"
        android:textColor="#FF6B00"
        android:textSize="10sp"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:visibility="invisible"/>

</LinearLayout>
