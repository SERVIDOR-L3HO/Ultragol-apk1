<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <!-- Glass card -->
    <FrameLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/profile_card_glass_v2"
        android:gravity="center">

        <!-- Top glare shimmer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="top"
            android:background="@drawable/gradient_top_black"
            android:alpha="0.04"
            android:scaleY="-1"/>

        <!-- Avatar glow ring -->
        <View
            android:id="@+id/avatarGlowRing"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:layout_gravity="center"
            android:background="@drawable/profile_avatar_glow_ring"
            android:alpha="0"
            android:visibility="visible"/>

        <!-- Avatar circle -->
        <FrameLayout
            android:id="@+id/avatarCircle"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/profile_avatar_circle">

            <TextView
                android:id="@+id/tvInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:fontFamily="sans-serif-black"/>
        </FrameLayout>

        <!-- Delete × top-right -->
        <FrameLayout
            android:id="@+id/btnDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/back_btn_glass"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"/>
        </FrameLayout>

        <!-- Kids badge top-left — professional pill with star icon -->
        <LinearLayout
            android:id="@+id/badgeKids"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/profile_kids_badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_profile_kids"
                android:layout_marginEnd="3dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KIDS"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"/>
        </LinearLayout>

    </FrameLayout>

    <!-- Profile name -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:text="Nombre"
        android:textColor="#EEFFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"/>

    <!-- PIN indicator -->
    <LinearLayout
        android:id="@+id/tvPinBadge"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="invisible">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_profile_pin"
            android:layout_marginEnd="3dp"
            android:alpha="0.85"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PIN"
            android:textColor="#FF6B00"
            android:textSize="10sp"
            android:fontFamily="sans-serif-bold"/>
    </LinearLayout>

</LinearLayout>
