<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Inline video player -->
            <FrameLayout android:id="@+id/webviewContainer"
                android:layout_width="match_parent" android:layout_height="212dp"
                android:background="#000000">
                <WebView android:id="@+id/playerWebView"
                    android:layout_width="match_parent" android:layout_height="match_parent"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="8dp" android:paddingEnd="16dp"
                    android:background="@drawable/gradient_top_black">
                    <ImageView android:id="@+id/btnPlayerBack"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:src="@android:drawable/ic_menu_revert"
                        android:tint="#FFFFFF" android:padding="8dp" android:clickable="true" android:focusable="true"/>
                    <TextView android:id="@+id/playerTitle"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="8dp"
                        android:textColor="#FFFFFF" android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" android:maxLines="1"
                        android:ellipsize="end"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/playerProgress"
                    android:layout_width="match_parent" android:layout_height="3dp"
                    android:layout_gravity="top" android:layout_marginTop="52dp"
                    android:progressDrawable="@drawable/progress_orange"
                    android:max="100" android:visibility="gone"
                    style="@android:style/Widget.ProgressBar.Horizontal"/>
            </FrameLayout>

            <!-- Detail info panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#000000"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/pdTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingMultiplier="1.1"/>

                <TextView
                    android:id="@+id/pdMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#88FFFFFF"
                    android:textSize="13sp"
                    android:letterSpacing="0.02"/>

                <!-- Action buttons row: Me gusta / Descargar / Reportar / Compartir -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:id="@+id/pdBtnLike"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/action_btn_bg">
                        <TextView android:id="@+id/pdLikeIcon"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="♡" android:textColor="#FFFFFF" android:textSize="18sp"/>
                        <TextView android:id="@+id/pdLikeLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Me gusta" android:textColor="#FFFFFF" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pdBtnDownload"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/action_btn_bg">
                        <TextView android:id="@+id/pdDownloadIcon"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⬇" android:textColor="#4FC3F7" android:textSize="18sp"/>
                        <TextView android:id="@+id/pdDownloadLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Descargar" android:textColor="#4FC3F7" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pdBtnCast"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/action_btn_bg">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_cast_tv"
                            android:tint="#FFFFFF"
                            android:contentDescription="Transmitir a TV"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Transmitir" android:textColor="#FFFFFF" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pdBtnShare"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/action_btn_bg">
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="↗" android:textColor="#FFFFFF" android:textSize="18sp"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Compartir" android:textColor="#FFFFFF" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Subtítulos / Doblaje -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:id="@+id/pdBtnSubs"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Subtítulos"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/btn_play_bg"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/pdBtnDub"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:text="Doblaje"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/action_btn_bg"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="18dp" android:background="#1AFFFFFF"/>

                <TextView
                    android:id="@+id/pdOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="#DDFFFFFF"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.6"
                    android:fontFamily="sans-serif"/>
            </LinearLayout>

            <!-- Similar movies -->
            <include android:id="@+id/pdRowSimilar" layout="@layout/row_section"/>

            <View android:layout_width="match_parent" android:layout_height="24dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" android:background="#000000"/>
</FrameLayout>
