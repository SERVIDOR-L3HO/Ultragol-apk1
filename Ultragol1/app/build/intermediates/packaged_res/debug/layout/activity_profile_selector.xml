<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080810">

    <!-- Background glow blobs -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="-80dp"
        android:background="@drawable/gradient_radial_splash"
        android:alpha="0.22"/>

    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-60dp"
        android:layout_marginBottom="-60dp"
        android:background="@drawable/gradient_radial_splash"
        android:alpha="0.14"/>

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Top bar with logo + manage button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical|start"
                android:src="@drawable/logo_ultragol"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:contentDescription="Ultragol"/>

            <TextView
                android:id="@+id/btnManage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:text="Gestionar"
                android:textColor="#FF6B00"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"/>
        </FrameLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#12FFFFFF"/>

        <!-- Title section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Quién está viendo?"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"/>

            <View
                android:layout_width="40dp"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:background="#FF6B00"/>
        </LinearLayout>

        <!-- Profile grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProfiles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:overScrollMode="never"/>

        <!-- Bottom hint -->
        <TextView
            android:id="@+id/tvManageHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Mantén pulsado un perfil para opciones"
            android:textColor="#44FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:gravity="center"/>

    </LinearLayout>

</FrameLayout>
