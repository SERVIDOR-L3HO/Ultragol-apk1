<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#44FF6B00"/>
        </shape>
    </item>
    <!-- Middle ring -->
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#22FF6B00"/>
            <stroke android:width="2dp" android:color="#CCFF6B00"/>
        </shape>
    </item>
    <!-- Inner fill (transparent, let avatar show through) -->
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
        </shape>
    </item>
</layer-list>
